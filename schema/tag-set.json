{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kytos.org/schema/tag-set/v1",
  "title": "TagSet",
  "description": "지식 조각에 붙는 태그 묶음. 지금 당장 연관을 만들지 않아도, 나중에 유관한 것끼리 이어붙이기 위해 다차원으로 분류해 둔다.",
  "type": "object",
  "properties": {
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "description": "주제 키워드. 자유 어휘.",
      "default": []
    },
    "orgs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "연관된 조직명. 아직 조직에 귀속된 것은 아니다 — 태그일 뿐이다.",
      "examples": [["bodytemple"], ["hyunhyun"]],
      "default": []
    },
    "domains": {
      "type": "array",
      "items": { "type": "string" },
      "description": "분야.",
      "examples": [["somatic"], ["philosophy"], ["business"]],
      "default": []
    },
    "tone": {
      "type": "array",
      "items": { "type": "string" },
      "description": "글의 성격/톤. 나중에 채널·형식을 고를 때의 단서가 된다.",
      "examples": [["healing"], ["academic"], ["commercial"], ["poetic"]],
      "default": []
    }
  },
  "additionalProperties": false
}
